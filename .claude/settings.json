{
  "permissions": {
    "additionalDirectories": [],
    "deny": [
      "Read(//**)",
      "Edit(//**)",
      "Write(//**)",
      "Read(./erp/**)",
      "Edit(./erp/**)",
      "Write(./erp/**)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ./*)",
      "Bash(git clone:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(git push origin main --force:*)"
    ],
    "allow": [
      "Read(./**)",
      "Edit(./**)",
      "Write(./**)",
      "Glob(./**)",
      "Grep(./**)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git restore:*)",
      "Bash(git stash:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git remote -v)",
      "Bash(git mv:*)",
      "Bash(git rm:*)",
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(mkdir:*)",
      "Bash(cat ./*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/warmup-check.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
