# Email institucional Livskin — variables de entorno
# Copia este file a keys/.env.integrations y rellena valores reales (gitignored)

# === Cloudflare Email Routing (INBOUND) ===
# Reusa CLOUDFLARE_API_TOKEN existente con scopes:
#   - Account:Email Routing Addresses:Edit
#   - Zone:Email Routing Rules:Edit
#   - Zone:DNS:Edit (para gestionar MX/TXT)
CLOUDFLARE_EMAIL_ZONE_ID=89ebefbde6dc2b1234a7da7872a9ab64  # livskin.site
CLOUDFLARE_EMAIL_ACCOUNT_ID=5c8c8d42417a0c5c0ae4640a392ebc8f
CLOUDFLARE_EMAIL_DESTINATION_ID=024aee8d4f6d4f37a5464e05409b19b5  # daizurma@gmail.com (principal)
CLOUDFLARE_EMAIL_DESTINATION_SECONDARY_ID=d4a8293a73c0483d8b3daa8b8b86bf9b  # daizurma2@gmail.com (disponible para futuros)
CLOUDFLARE_EMAIL_RULE_INFO_ID=5c093602644245d5b9cdf0831d1d372c  # info@livskin.site -> daizurma@

# === Brevo SMTP (OUTBOUND) ===
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=  # típico: daizurma2@gmail.com o el email cuenta Brevo
BREVO_SMTP_KEY=   # generada en Brevo dashboard → SMTP & API → SMTP keys

# === API Key Brevo (opcional, para email transaccional vía API REST) ===
BREVO_API_KEY=    # generada en Brevo dashboard → SMTP & API → API keys (v3)
